{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|css/|app/|vendor/|sample_resumes/|uploads/|favicon.ico|index.html).*)",
      "destination": "/index.html"
    }
  ]
}
