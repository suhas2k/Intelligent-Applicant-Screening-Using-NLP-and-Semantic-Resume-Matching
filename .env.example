# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/applicant_screening

# JWT Secret for Recruiter Authentication
JWT_SECRET=super_secret_jwt_key_applicant_screening_2026_xyz

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword

# Google OAuth 2.0 Configuration
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Email OTP SMTP Infrastructure Configuration (Nodemailer)
# Gmail: Host: smtp.gmail.com, Port: 587, Secure: false (STARTTLS)
# Password: Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=manisuhas23@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="ResumeIQ Security" <manisuhas23@gmail.com>
EMAIL_FROM_NAME=ResumeIQ Security
