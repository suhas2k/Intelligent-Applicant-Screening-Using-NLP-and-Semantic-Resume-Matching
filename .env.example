# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If running MongoDB locally: mongodb://127.0.0.1:27017/applicant_screening
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/applicant_screening
MONGODB_URI=mongodb://127.0.0.1:27017/applicant_screening

# JWT Secret for Recruiter Authentication
JWT_SECRET=super_secret_jwt_key_applicant_screening_2026_xyz

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword
