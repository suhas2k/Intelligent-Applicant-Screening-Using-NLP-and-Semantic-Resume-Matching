# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If running MongoDB locally: mongodb://127.0.0.1:27017/applicant_screening
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/applicant_screening
MONGODB_URI=mongodb://127.0.0.1:27017/applicant_screening

# JWT Secret for Recruiter Authentication
JWT_SECRET=super_secret_jwt_key_applicant_screening_2026_xyz

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword

# -------------------------------------------------------------
# Real Google Accounts Authentication (Google Identity Services)
# -------------------------------------------------------------
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# -------------------------------------------------------------
# Real Email OTP Configuration (Nodemailer)
# -------------------------------------------------------------
# For direct email delivery to user inboxes, configure your SMTP server or Gmail App Password:
# (If left empty, ResumeIQ automatically uses Ethereal test mail with live web preview links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="ResumeIQ Security" <your_email@gmail.com>
